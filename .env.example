# Mock работает без окружения и ключей. Live включается только CLI --provider live.
# Для live: установить LLM_MODEL с префиксом openai/, anthropic/ или gemini/.
# .env автоматически не загружается; экспортировать переменные в окружение.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Лимиты server-owned (Budgets); company/seed/output/provider задаются CLI.
