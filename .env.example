# Mock работает без окружения и ключей. Live включается только CLI --provider live.
# .env автоматически не загружается; экспортировать переменные в окружение.

# LiteLLM Gateway: заменить alias на model_name из конфигурации Gateway.
# Например LITELLM_PROXY_API_BASE=http://localhost:4000 (адрес сервера Gateway).
# Можно указать /v1 или reverse-proxy prefix; trailing slash удаляется.
LLM_MODEL=litellm_proxy/your-model-alias
LITELLM_PROXY_API_BASE=
LITELLM_PROXY_API_KEY=

# Прямой API: вместо litellm_proxy/ использовать openai/, anthropic/ или gemini/.
# Заполняется ключ только выбранного прямого провайдера.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Лимиты server-owned (Budgets); company/seed/output/provider задаются CLI.
