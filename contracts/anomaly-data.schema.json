{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anomaly-data.schema.json",
  "title": "anomaly-data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "anomaly_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "transaction_outlier",
              "monthly_spend_jump",
              "new_spend",
              "unclassified_cross_border"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "baseline_amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold_amount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_on": {
            "type": "string",
            "format": "date"
          },
          "transaction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "baseline_transaction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "method": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "anomaly_id",
          "kind",
          "amount",
          "baseline_amount",
          "threshold_amount",
          "observed_on",
          "transaction_ids",
          "baseline_transaction_ids",
          "method",
          "caveats"
        ]
      },
      "minItems": 0
    },
    "unclassified_cross_border_total": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "unclassified_cross_border_transaction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "findings",
    "unclassified_cross_border_total",
    "unclassified_cross_border_transaction_ids"
  ]
}
