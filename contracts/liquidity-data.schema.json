{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liquidity-data.schema.json",
  "title": "liquidity-data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "opening_cash": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "closing_cash": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "minimum_cash": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "minimum_cash_date": {
      "type": "string",
      "format": "date"
    },
    "cash_gap_intervals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "open_at_period_end": {
            "type": "boolean"
          }
        },
        "required": [
          "start",
          "end",
          "open_at_period_end"
        ]
      },
      "minItems": 0
    },
    "operating_inflows": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "operating_outflows": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "monthly": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "operating_inflows": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "operating_outflows": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "net_burn": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "transaction_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "month",
          "operating_inflows",
          "operating_outflows",
          "net_burn",
          "transaction_ids"
        ]
      },
      "minItems": 1
    },
    "average_net_burn": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "last_month_net_burn": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "runway_status": {
      "type": "string",
      "enum": [
        "finite",
        "cash_depleted",
        "not_burning"
      ]
    },
    "runway_months": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_month_stress_runway_months": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "gross_coverage_months": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payment_lag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "median_days": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "net_60_count": {
          "type": "integer",
          "minimum": 0
        },
        "net_90_count": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "receipt_count",
        "median_days",
        "net_60_count",
        "net_90_count",
        "transaction_ids"
      ]
    },
    "low_runway": {
      "type": "boolean"
    },
    "last_month_stress_low_runway": {
      "type": "boolean"
    }
  },
  "required": [
    "opening_cash",
    "closing_cash",
    "minimum_cash",
    "minimum_cash_date",
    "cash_gap_intervals",
    "operating_inflows",
    "operating_outflows",
    "monthly",
    "average_net_burn",
    "last_month_net_burn",
    "runway_status",
    "runway_months",
    "last_month_stress_runway_months",
    "gross_coverage_months",
    "payment_lag",
    "low_runway",
    "last_month_stress_low_runway"
  ]
}
