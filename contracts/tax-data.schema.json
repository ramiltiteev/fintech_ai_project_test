{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tax-data.schema.json",
  "title": "tax-data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ruleset_id": {
      "const": "hk-expense-review-v1"
    },
    "rules_verified_on": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "review_required"
    },
    "filing_ready": {
      "const": false
    },
    "assessable_profit": {
      "type": "null"
    },
    "tax_payable": {
      "type": "null"
    },
    "expense_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "revenue",
              "rent",
              "fuel",
              "logistics",
              "subcontractors",
              "rd_contractors",
              "cloud_services",
              "other_opex",
              "inventory",
              "capital_equipment",
              "profits_tax",
              "taxes_other",
              "unknown"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "potentially_deductible",
              "non_deductible",
              "review_required",
              "outside_expense_scope"
            ]
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1
          },
          "missing_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "transaction_id",
          "amount",
          "category",
          "decision",
          "rule_id",
          "reason_code",
          "source_urls",
          "missing_evidence"
        ]
      },
      "minItems": 0
    },
    "decision_totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "potentially_deductible": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "non_deductible": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "review_required": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "outside_expense_scope": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        }
      },
      "required": [
        "potentially_deductible",
        "non_deductible",
        "review_required",
        "outside_expense_scope"
      ]
    },
    "total_cash_debits": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "ruleset_id",
    "rules_verified_on",
    "status",
    "filing_ready",
    "assessable_profit",
    "tax_payable",
    "expense_rows",
    "decision_totals",
    "total_cash_debits",
    "missing_inputs"
  ]
}
