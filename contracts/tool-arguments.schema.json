{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-arguments.schema.json",
  "title": "tool-arguments",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "company_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "company_id",
    "snapshot_id",
    "period_start",
    "period_end"
  ]
}
