{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact.schema.json",
  "title": "fact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "tool_result_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "metric": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        {
          "type": "null"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "HKD",
        "months",
        "percent",
        "days",
        "date",
        "ids",
        "status",
        "count",
        "flag"
      ]
    },
    "transaction_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "derivation_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "fact_id",
    "tool_result_id",
    "metric",
    "value",
    "unit",
    "transaction_ids",
    "derivation_code"
  ]
}
