{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset.schema.json",
  "title": "dataset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "const": "HK"
        },
        "functional_currency": {
          "const": "HKD"
        }
      },
      "required": [
        "company_id",
        "name",
        "industry",
        "jurisdiction",
        "functional_currency"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "opening_balance": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "posted_on": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
            "not": {
              "const": "0.00"
            }
          },
          "currency": {
            "const": "HKD"
          },
          "direction": {
            "type": "string",
            "enum": [
              "credit",
              "debit"
            ]
          },
          "movement_type": {
            "type": "string",
            "enum": [
              "operating",
              "financing",
              "investing",
              "tax",
              "transfer"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "revenue",
              "rent",
              "fuel",
              "logistics",
              "subcontractors",
              "rd_contractors",
              "cloud_services",
              "other_opex",
              "inventory",
              "capital_equipment",
              "profits_tax",
              "taxes_other",
              "unknown"
            ]
          },
          "counterparty": {
            "type": "string",
            "minLength": 1
          },
          "counterparty_country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "invoice_issued_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment_terms_days": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  60,
                  90
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "synthetic": {
                "const": true
              },
              "business_purpose_confirmed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "chargeable_profits_link_confirmed": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "documentation_available": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "capital_nature": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "tax_kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "profits_tax",
                      "other",
                      "unknown"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "synthetic",
              "business_purpose_confirmed",
              "chargeable_profits_link_confirmed",
              "documentation_available",
              "capital_nature",
              "tax_kind"
            ]
          }
        },
        "required": [
          "transaction_id",
          "posted_on",
          "amount",
          "currency",
          "direction",
          "movement_type",
          "category",
          "counterparty",
          "counterparty_country",
          "description",
          "invoice_issued_on",
          "payment_terms_days",
          "evidence"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "company",
    "seed",
    "period_start",
    "period_end",
    "opening_balance",
    "transactions"
  ]
}
